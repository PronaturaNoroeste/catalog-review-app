# Console (catalog-review-app) — copy to `.env` and fill with PROD values.
# NEVER commit `.env` (it's gitignored). console_config.py reads env first, then this file.
#
# The service-role key is a SECRET: it lives ONLY in the console's server-side env.
# Never put it in the capture app, in git, in image layers, or in logs.

# Direct Postgres DSN for the form builder / catalog admin (Supabase → Settings → Database).
# Use the connection *pooler* URI for a hosted deployment. sslmode=require is added if missing.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROD-REF.supabase.co:5432/postgres

# Supabase project (Settings → API). The URL + anon (publishable) key are not secret;
# the service_role key IS — it bypasses RLS and is used to create auth users (👤 Usuarios).
SUPABASE_URL=https://YOUR-PROD-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-PROD-ANON-PUBLISHABLE-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-PROD-SERVICE-ROLE-KEY
