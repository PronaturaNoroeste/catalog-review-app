# Reverse proxy with automatic HTTPS. CONSOLE_DOMAIN is set by docker-compose.
# Streamlit uses websockets; Caddy proxies them transparently.
{$CONSOLE_DOMAIN} {
	encode zstd gzip
	reverse_proxy console:8501

